# Destino del proxy /api en desarrollo (gateway). En esta máquina el 8080 está ocupado: usar el puerto del .env del backend.
VITE_API_PROXY=http://localhost:8080
# true: MSW responde en el navegador (también disponible con npm run dev:mocks)
VITE_USE_MOCKS=false
# Mostrar el botón "Recibir" en reposiciones
VITE_FEATURE_RECIBIR=true
